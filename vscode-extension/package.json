{
  "name": "joe-control-room",
  "displayName": "Joe",
  "description": "VS Code control room for conversations and runs on a local Joe server.",
  "version": "0.3.0",
  "publisher": "felixquinton",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/felixquinton1/joe.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:joe.overview",
    "onCommand:joe.refresh",
    "onCommand:joe.createConversation",
    "onCommand:joe.sendPrompt",
    "onCommand:joe.cancelRun",
    "onCommand:joe.restart",
    "onCommand:joe.openGuide"
  ],
  "contributes": {
    "commands": [
      {
        "command": "joe.refresh",
        "title": "Joe: Actualiser"
      },
      {
        "command": "joe.restart",
        "title": "Joe: Redémarrer le serveur",
        "icon": "$(debug-restart)"
      },
      {
        "command": "joe.createConversation",
        "title": "Joe: Nouvelle conversation",
        "icon": "$(add)"
      },
      {
        "command": "joe.sendPrompt",
        "title": "Joe: Envoyer une demande",
        "icon": "$(send)"
      },
      {
        "command": "joe.cancelRun",
        "title": "Joe: Annuler la requête",
        "icon": "$(debug-stop)"
      },
      {
        "command": "joe.openGuide",
        "title": "Joe: Ouvrir le guide",
        "icon": "$(question)"
      },
      {
        "command": "joe.zoomIn",
        "title": "Joe: Zoomer"
      },
      {
        "command": "joe.zoomOut",
        "title": "Joe: Dézoomer"
      },
      {
        "command": "joe.zoomReset",
        "title": "Joe: Réinitialiser le zoom"
      }
    ],
    "configuration": {
      "title": "Joe",
      "properties": {
        "joe.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "Adresse locale du serveur Joe sur l’hôte du workspace."
        },
        "joe.allowWorkspaceWrites": {
          "type": "boolean",
          "default": false,
          "description": "Autorise les demandes VS Code à conserver le mode d’écriture de la conversation. Désactivé, l’extension impose le mode lecture seule."
        },
        "joe.enableMaintenanceActions": {
          "type": "boolean",
          "default": false,
          "description": "Affiche et autorise les actions de maintenance sensibles, comme le redémarrage du serveur."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "joe",
          "title": "Joe",
          "icon": "media/joe.svg"
        }
      ]
    },
    "views": {
      "joe": [
        {
          "id": "joe.overview",
          "name": "État et conversations"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "joe.refresh",
          "when": "view == joe.overview",
          "group": "navigation"
        },
        {
          "command": "joe.restart",
          "when": "view == joe.overview && config.joe.enableMaintenanceActions",
          "group": "navigation@4"
        },
        {
          "command": "joe.createConversation",
          "when": "view == joe.overview",
          "group": "navigation@2"
        },
        {
          "command": "joe.sendPrompt",
          "when": "view == joe.overview",
          "group": "navigation@3"
        },
        {
          "command": "joe.cancelRun",
          "when": "view == joe.overview",
          "group": "navigation@3"
        },
        {
          "command": "joe.openGuide",
          "when": "view == joe.overview",
          "group": "navigation@5"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.7.0",
    "typescript": "^5.7.0"
  }
}
