{
  "name": "joe-control-room",
  "displayName": "Joe",
  "description": "Read-only VS Code control room for a local Joe server.",
  "version": "0.1.2",
  "publisher": "felixquinton",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/felixquinton1/joe.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:joe.overview",
    "onCommand:joe.refresh",
    "onCommand:joe.restart"
  ],
  "contributes": {
    "commands": [
      {
        "command": "joe.refresh",
        "title": "Joe: Actualiser"
      },
      {
        "command": "joe.restart",
        "title": "Joe: Redémarrer le serveur",
        "icon": "$(debug-restart)"
      }
    ],
    "configuration": {
      "title": "Joe",
      "properties": {
        "joe.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "Adresse locale du serveur Joe sur l’hôte du workspace."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "joe",
          "title": "Joe",
          "icon": "media/joe.svg"
        }
      ]
    },
    "views": {
      "joe": [
        {
          "id": "joe.overview",
          "name": "État et conversations"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "joe.refresh",
          "when": "view == joe.overview",
          "group": "navigation"
        },
        {
          "command": "joe.restart",
          "when": "view == joe.overview",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.7.0",
    "typescript": "^5.7.0"
  }
}
