{
  "name": "joe-control-room",
  "displayName": "Joe",
  "description": "Start, open, restart and stop the local Joe Web interface.",
  "version": "0.4.3",
  "publisher": "felixquinton",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/felixquinton1/joe.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:joe.overview",
    "onCommand:joe.refresh",
    "onCommand:joe.start",
    "onCommand:joe.openWeb",
    "onCommand:joe.stop",
    "onCommand:joe.restart",
    "onCommand:joe.openGuide"
  ],
  "contributes": {
    "commands": [
      {
        "command": "joe.refresh",
        "title": "Joe: Refresh status",
        "icon": "$(refresh)"
      },
      {
        "command": "joe.start",
        "title": "Joe: Start",
        "icon": "$(play)"
      },
      {
        "command": "joe.openWeb",
        "title": "Joe: Open Web interface",
        "icon": "$(globe)"
      },
      {
        "command": "joe.restart",
        "title": "Joe: Restart server",
        "icon": "$(debug-restart)"
      },
      {
        "command": "joe.stop",
        "title": "Joe: Stop server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "joe.openGuide",
        "title": "Joe: Open guide",
        "icon": "$(question)"
      },
      {
        "command": "joe.zoomIn",
        "title": "Joe: Zoom in"
      },
      {
        "command": "joe.zoomOut",
        "title": "Joe: Zoom out"
      },
      {
        "command": "joe.zoomReset",
        "title": "Joe: Reset zoom"
      }
    ],
    "configuration": {
      "title": "Joe",
      "properties": {
        "joe.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "Local Joe server URL on the workspace host."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "joe",
          "title": "Joe",
          "icon": "media/joe.svg"
        }
      ]
    },
    "views": {
      "joe": [
        {
          "id": "joe.overview",
          "name": "Joe Web"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "joe.refresh",
          "when": "view == joe.overview",
          "group": "navigation"
        },
        {
          "command": "joe.start",
          "when": "view == joe.overview",
          "group": "navigation@1"
        },
        {
          "command": "joe.openWeb",
          "when": "view == joe.overview",
          "group": "navigation@2"
        },
        {
          "command": "joe.restart",
          "when": "view == joe.overview",
          "group": "navigation@3"
        },
        {
          "command": "joe.stop",
          "when": "view == joe.overview",
          "group": "navigation@4"
        },
        {
          "command": "joe.openGuide",
          "when": "view == joe.overview",
          "group": "navigation@5"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
